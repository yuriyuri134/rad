{
  "id": "eval-mtf-chromatic",
  "name": "MTF30 与消色差严格评价器",
  "kind": "evaluator",
  "runtime": "local_process_mjs",
  "summary": "同时约束 30 lp/mm MTF 对比度与 F-C 轴向色差漂移，暴露单透镜盲区。",
  "purpose": "在不推翻原始光线追迹证据的前提下，用更严格的成像质量标准重新审视历史设计。",
  "capabilityBoundary": "可对历史产物重评，也可以作为优化器的实时损失函数；若产物缺少 mtf30LpMm 或色差字段则拒评。",
  "inputs": [
    {
      "name": "rawArtifacts",
      "type": "RayTraceResult",
      "description": "需包含 mtf30LpMm 与 axialChromaticShiftMm"
    },
    {
      "name": "spec",
      "type": "OpticalSystemSpec",
      "description": "目标焦距规格"
    }
  ],
  "outputs": [
    {
      "name": "verdict",
      "type": "EvaluationVerdict",
      "description": "严格多指标核查结论"
    }
  ],
  "dependencies": [],
  "compatibility": [
    "产出 MTF 与多波段色差指标的光学求解器"
  ],
  "assumptions": [
    "默认 30 lp/mm 作为中等空间频率基准"
  ],
  "limits": [
    "单透镜通常无法同时满足 0.45mm 色差上限。"
  ],
  "editableParts": [
    "minMtf30 阈值",
    "maxChromaticMm 阈值",
    "lossScore 权重公式"
  ],
  "parameters": [
    {
      "key": "minMtf30",
      "label": "MTF@30lp 最低要求",
      "type": "number",
      "defaultValue": 0.35,
      "min": 0.05,
      "max": 0.9,
      "step": 0.05,
      "unit": "",
      "description": "30 lp/mm 最低 MTF"
    },
    {
      "key": "maxChromaticMm",
      "label": "F-C 色差上限",
      "type": "number",
      "defaultValue": 0.45,
      "min": 0.05,
      "max": 3,
      "step": 0.05,
      "unit": "mm",
      "description": "486/656nm 轴向焦移上限"
    },
    {
      "key": "eflToleranceMm",
      "label": "焦距容差",
      "type": "number",
      "defaultValue": 2.5,
      "min": 0.2,
      "max": 15,
      "step": 0.2,
      "unit": "mm",
      "description": "EFL 允许偏差"
    }
  ],
  "selfCheck": {
