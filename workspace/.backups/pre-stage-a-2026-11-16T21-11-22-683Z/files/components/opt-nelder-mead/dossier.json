    "summary": "已通过二维耦合抛物面收敛自检"
  },
  "scientificValidation": {
    "status": "limited_preview",
    "basis": "经典 Nelder-Mead 启发式算法，适合中低维无导数目标，不能替代 Optiland 解析雅可比阻尼最小二乘法。",
    "caveats": [
      "受初始单纯形尺度影响"
    ]
  },
