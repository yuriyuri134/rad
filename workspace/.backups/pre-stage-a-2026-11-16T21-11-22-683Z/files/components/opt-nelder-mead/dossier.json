{
  "id": "opt-nelder-mead",
  "name": "Nelder-Mead 单纯形优化器",
  "kind": "optimizer",
  "runtime": "local_process_mjs",
  "summary": "通过多面体反射/扩展/收缩协同调整多个表面曲率，适于耦合谷地搜索。",
  "purpose": "作为可替换优化算法，在保持结构与评价器不变的条件下对比搜索路径与收敛效率。",
  "capabilityBoundary": "支持多维连续参数协同寻优，不支持离散玻璃替换。",
  "inputs": [
    {
      "name": "initialSpec",
      "type": "OpticalSystemSpec",
      "description": "初始光学结构"
    },
    {
      "name": "helpers",
      "type": "Trace + Evaluate",
      "description": "求解器与评价器句柄"
    }
  ],
  "outputs": [
    {
      "name": "optimized",
      "type": "{ bestSpec, bestTrace, bestEval, history }",
      "description": "优化后结构与每轮收敛指标"
    }
  ],
  "dependencies": [],
  "compatibility": [
    "任意 optical_solver 组件",
    "任意 evaluator 组件"
  ],
  "assumptions": [
    "默认反射=1.0, 扩展=2.0, 收缩=0.5"
  ],
  "limits": [
    "变量较多时（>6维）单纯形退化概率上升。"
  ],
  "editableParts": [
    "单纯形缩放参数",
    "最大迭代次数",
    "退化重启策略"
  ],
  "parameters": [
    {
      "key": "maxIterations",
      "label": "最大迭代步数",
      "type": "number",
      "defaultValue": 24,
      "min": 5,
      "max": 45,
      "step": 2,
      "unit": "steps",
      "description": "单纯形更新轮数"
    },
    {
      "key": "simplexScaleMm",
      "label": "初始单纯形尺度",
      "type": "number",
      "defaultValue": 5.5,
      "min": 1,
      "max": 20,
      "step": 0.5,
      "unit": "mm",
      "description": "各维度初始步长"
    }
  ],
  "selfCheck": {
    "status": "passed",
    "checkedAt": "2026-11-16T18:47:22.762Z",
