{
  "taskId": "p1-optics-benchmark-v1",
  "title": "100 mm F/4 单透镜与双胶合消色差镜头几何光学设计对比基准",
  "stage": "P1",
  "status": "active",
  "opticalSpec": {
    "targetEflMm": 100.0,
    "eflToleranceMm": 1.0,
    "entrancePupilDiameterMm": 25.0,
    "fNumber": 4.0,
    "objectDistance": "infinity",
    "wavelengthsUm": {
      "F": 0.48613,
      "d": 0.58756,
      "C": 0.65627
    },
    "primaryWavelengthUm": 0.58756,
    "fieldAnglesDeg": [0.0, 0.5, 1.0],
    "defaultSemiApertureMm": 14.0,
    "projectionModel": "ideal_pinhole_f_tan_theta"
  },
  "focusRule": {
    "ruleId": "fixed_on_axis_d_or_locked_global_plane",
    "description": "每套系统必须先在轴上(0°) d线(587.56 nm)确定近轴像面（或在优化中把后截距 BFL 作为单一全局像面位置变量联合求解并锁定），随后冻结该单一像面位置，在完全不逐视场/逐波长重调焦的前提下评价 F/d/C 三波段与 0°/0.5°/1° 三视场。",
    "forbidPerConditionRefocus": true
  },
  "physicalConstraints": {
    "minCenterThicknessMm": 2.0,
    "minFlintThicknessMm": 1.5,
    "minEdgeThicknessMm": 1.0,
    "maxClippedRays": 0,
    "maxTirRays": 0
  },
  "evaluationProtocol": {
    "domain": "geometric_optics_only",
    "noDiffractionPsfMixing": true,
    "metrics": [
      "paraxialEflMm",
      "eflErrorMm",
      "fixedBflMm",
      "axialChromaticShiftFcMm",
      "rmsSpotRadiusByFieldAndWavelengthUm",
      "polychromaticRmsSpotByFieldUm",
      "chiefRayHeightMm",
      "idealHeightMm",
      "distortionPct",
      "centroidShiftFromChiefRayUm",
      "lateralColorFcUmAt1Deg",
      "seidelSummary",
      "vignettingFraction",
      "geometricMtf30And60AtPrimaryDLine",
      "airyRadiusReferenceUm_forReferenceOnly"
    ]
  }
}
